# 🚀 Configuración de Producción
# Este archivo se usa automáticamente cuando ejecutas `npm run build`

# ⚠️ IMPORTANTE: Reemplaza estas URLs con tu backend real en Railway
# NO DEPLEGAR CON ESTAS URLs DE EJEMPLO - DEBES CAMBIARLAS

VITE_API_URL=https://YOUR-BACKEND-URL.up.railway.app/api
VITE_SOCKET_URL=https://YOUR-BACKEND-URL.up.railway.app

# 💡 Tip: Obtén tu URL de Railway desde el dashboard → Settings → Domains
# 📝 Ejemplo real: https://cafeteria-production.up.railway.app

